# Pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://user:password@your-project-pooler.region.aws.neon.tech/neondb?sslmode=verify-full

# Any long random string, used to sign login tokens
JWT_SECRET=replace-with-a-long-random-string

# Address of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

PORT=4000
